# Select HTTP or HTTPS in these URLs. Supply secrets only in an untracked mode-600 file.
MB_SITE_URL=https://portal.example/metabase
MB_OSS_KEYCLOAK_ENABLED=true
MB_OSS_KEYCLOAK_ISSUER=https://identity.example/realms/enterprise-ai
MB_OSS_KEYCLOAK_CLIENT_ID=oss-metabase
MB_OSS_KEYCLOAK_CLIENT_SECRET=
MB_ENCRYPTION_SECRET_KEY=
MB_OSS_KEYCLOAK_PORTAL_PATH=/portal/data
MB_OSS_WORKSPACE_EMBEDDING_ENABLED=true
# Allow only the fixed IdP address if its DNS resolves to a private network.
# Use the existing oidc-allowed-networks setting; do not enable allow-all in production.
# Preserve all existing MB_DB_* settings and native permissions.

# HTTP alternative (replace the corresponding values above; no additional Metabase switch):
# MB_SITE_URL=http://portal.example:9433/metabase
# MB_OSS_KEYCLOAK_ISSUER=http://portal.example:9433/realms/enterprise-ai
# LibreChat: PORTAL_DATA_CENTER_URL=http://portal.example:9433/metabase/
# LibreChat's existing HTTP policy: PORTAL_ALLOW_HTTP=true
# HTTPS alternative: PORTAL_DATA_CENTER_URL=https://portal.example/metabase/
# Keep the existing PORTAL_DOCUMENT_CENTER_URL and other portal settings.
# Update Keycloak exact redirect/backchannel/post-logout URLs to the chosen scheme and origin.
# HTTP entry requires the Keycloak realm SSL policy to allow HTTP as well.
